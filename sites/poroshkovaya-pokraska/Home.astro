---
// Посадочная «Палитры ДВ» — композиция по мотивам Astro Rocket: градиентный первый экран с образцами RAL,
// карточки, этапы, палитра, «о цехе», вопросы, карточка-призыв с формой.
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { Content as Text } from './text.md';
import site, { phoneHref } from '../../src/lib/site.js';

const h = site.hero;
const heroRal = site.ral.slice(0, 8);
---
<section class="hero">
  <div class="wrap hero__in">
    <span class="hero__pill">{h.eyebrow}</span>
    <h1>{h.title}</h1>
    <p class="hero__lead">{h.lead}</p>
    <div class="hero__btns">
      <a class="btn btn--white" href="#lead">Рассчитать покраску <span aria-hidden="true">→</span></a>
      <a class="btn btn--glass" href={phoneHref}>Позвонить</a>
    </div>
    <div class="hero__ral">
      <span class="hero__ral-k">Примерьте цвет:</span>
      <div class="hero__sw" role="group" aria-label="Цвет RAL для сайта">
        {heroRal.map(([n, name, hex]) => (
          <button type="button" class="sw" data-ral={n} aria-pressed="false" style={`--c:${hex}`} title={`RAL ${n} · ${name}`} aria-label={`RAL ${n}, ${name}`}></button>
        ))}
      </div>
      <span class="hero__ral-name" data-ral-label>RAL {site.ral[0][0]} · {site.ral[0][1]}</span>
    </div>
  </div>
</section>

<section class="sec" id="what">
  <div class="wrap">
    <div class="sec__head"><span class="pill">{site.what.eyebrow}</span><h2>{site.what.title}</h2><p>{site.what.lead}</p></div>
    <div class="cards cards--3">
      {site.what.items.map(([ico, t, p]) => (
        <article class="card card--center">
          <span class="card__ico"><Icon name={ico} size={30} /></span>
          <h3>{t}</h3>
          <p>{p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sec sec--white" id="why">
  <div class="wrap">
    <div class="sec__head"><span class="pill">{site.why.eyebrow}</span><h2>{site.why.title}</h2><p>{site.why.lead}</p></div>
    <div class="cards cards--4">
      {site.why.items.map(([ico, t, p]) => (
        <article class="card card--tint card--center">
          <span class="card__ico"><Icon name={ico} size={28} /></span>
          <h3>{t}</h3>
          <p>{p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sec" id="steps">
  <div class="wrap">
    <div class="sec__head"><span class="pill">{site.steps.eyebrow}</span><h2>{site.steps.title}</h2></div>
    <ol class="cards cards--2 steps">
      {site.steps.items.map(([t, p, tags], i) => (
        <li class="card step">
          <div class="step__top"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><span class="step__bar" style={`--w:${(i + 1) * 25}%`}></span></div>
          <h3>{t}</h3>
          <p>{p}</p>
          <div class="tags">{tags.map((g) => <span>#{g}</span>)}</div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="sec sec--white" id="palette">
  <div class="wrap">
    <div class="sec__head"><span class="pill">{site.palette.eyebrow}</span><h2>{site.palette.title}</h2><p>{site.palette.lead}</p></div>
    <div class="pal">
      {site.ral.map(([n, name, hex]) => (
        <button type="button" class="chip" data-ral={n} aria-pressed="false" aria-label={`RAL ${n}, ${name} — перекрасить сайт`}>
          <span class="chip__sw" style={`background:${hex}`}></span>
          <span class="chip__n">RAL {n}</span>
          <span class="chip__name">{name}</span>
        </button>
      ))}
    </div>
    <p class="pal__note">{site.palette.note}</p>
  </div>
</section>

<section class="sec" id="about">
  <div class="wrap about">
    <div class="about__text">
      <span class="pill">{site.about.eyebrow}</span>
      <h2>{site.about.title} <span class="about__accent">{site.about.titleAccent}</span></h2>
      {site.about.text.map((p) => <p>{p}</p>)}
      <a class="btn btn--line" href="#lead">Отправить заявку <span aria-hidden="true">→</span></a>
    </div>
    <div class="facts">
      <p class="facts__h">Коротко о покраске</p>
      <div class="facts__grid">
        {site.about.facts.map(([ico, t]) => (
          <div class="fact"><span class="fact__ico"><Icon name={ico} size={28} /></span><span>{t}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="sec sec--white" id="faq">
  <div class="wrap">
    <div class="sec__head"><span class="pill">Вопросы</span><h2>Частые вопросы</h2></div>
    <div class="faq">
      {site.faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="sec" id="lead">
  <div class="wrap">
    <div class="cta">
      <div class="cta__text">
        <h2>Расскажите, что покрасить</h2>
        <p>Пришлите фото, чертёж или размеры и номер RAL — посчитаем стоимость и скажем срок.</p>
        <p class="cta__ral">Сейчас выбран: <b data-ral-label>RAL {site.ral[0][0]} · {site.ral[0][1]}</b></p>
      </div>
      <LeadForm />
    </div>
  </div>
</section>

<section class="sec sec--white" id="text">
  <div class="wrap text"><Text /></div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, color-mix(in srgb, var(--ral) 88%, #000) 0%, color-mix(in srgb, var(--ral) 45%, var(--graphite)) 42%, var(--graphite) 100%);
    color: #fff; padding: 168px 0 112px; transition: background 0.4s;
  }
  .hero__in { display: grid; justify-items: center; text-align: center; gap: 22px; }
  .hero__pill { font-size: 14px; font-weight: 600; padding: 7px 14px; border-radius: 999px; background: rgba(0, 0, 0, 0.28); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28); }
  .hero h1 { font-size: clamp(38px, 6vw, 76px); max-width: 960px; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25); }
  .hero__lead { font-size: clamp(17px, 1.6vw, 20px); color: rgba(255, 255, 255, 0.82); max-width: 640px; }
  .hero__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }
  .hero__ral { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 14px; margin-top: 18px; padding: 12px 16px; border-radius: 16px; background: rgba(0, 0, 0, 0.3); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
  .hero__ral-k { font-size: 14px; color: rgba(255, 255, 255, 0.75); }
  .hero__sw { display: flex; gap: 8px; }
  .hero__ral-name { font-size: 14px; font-weight: 600; min-width: 220px; text-align: left; }
  .sw { width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--c); cursor: pointer; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); transition: transform 0.15s, box-shadow 0.15s; }
  .sw:hover { transform: scale(1.12); }
  .sw[aria-pressed='true'] { box-shadow: 0 0 0 2px var(--graphite), 0 0 0 4px #fff; }
  @media (max-width: 640px) {
    .hero { padding: 124px 0 72px; }
    .hero__ral-name { min-width: 0; text-align: center; width: 100%; }
    .sw { width: 28px; height: 28px; }
  }

  .cards { display: grid; gap: 20px; list-style: none; margin: 0; padding: 0; }
  .cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 960px) { .cards--3, .cards--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .cards--3, .cards--4, .cards--2 { grid-template-columns: minmax(0, 1fr); } }
  .card { background: var(--card); border: 1px solid var(--ral-line); border-radius: var(--r-lg); padding: 28px; display: grid; gap: 10px; align-content: start; box-shadow: 0 6px 24px rgba(17, 18, 22, 0.05); transition: border-color 0.3s; }
  .card p { color: var(--muted); }
  .card--center { justify-items: center; text-align: center; }
  .card--tint { background: var(--ral-soft); }
  .card__ico { color: var(--ral-accent); margin-bottom: 4px; transition: color 0.3s; }

  .step__top { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
  .step__n { font: 700 15px/1 var(--f-head); color: var(--ral-accent); }
  .step__bar { flex: 1; height: 4px; border-radius: 4px; background: var(--line); position: relative; overflow: hidden; }
  .step__bar::after { content: ''; position: absolute; inset: 0; width: var(--w); background: var(--ral); transition: background 0.3s; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .tags span { font-size: 13px; color: var(--ral-accent); background: var(--ral-soft); border: 1px solid var(--ral-line); padding: 3px 9px; border-radius: 999px; }

  .pal { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
  .chip { display: grid; gap: 4px; text-align: left; padding: 10px 10px 12px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); cursor: pointer; font: inherit; color: inherit; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
  .chip:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(17, 18, 22, 0.1); }
  .chip[aria-pressed='true'] { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
  .chip__sw { height: 72px; border-radius: 10px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08); margin-bottom: 6px; }
  .chip__n { font: 600 15px/1.2 var(--f-head); }
  .chip__name { font-size: 13px; color: var(--muted); line-height: 1.3; }
  .pal__note { text-align: center; color: var(--muted); font-size: 14px; margin-top: 24px; }
  @media (max-width: 960px) { .pal { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .pal { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .chip__sw { height: 56px; } }

  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .about__text { display: grid; gap: 18px; justify-items: start; }
  .about__text p { color: #3d3f47; font-size: 18px; }
  .about__accent { color: var(--ral-accent); transition: color 0.3s; }
  .facts { background: var(--card); border: 1px solid var(--ral-line); border-radius: var(--r-lg); padding: 24px; box-shadow: 0 6px 24px rgba(17, 18, 22, 0.05); }
  .facts__h { text-align: center; font-weight: 600; color: var(--ral-accent); margin-bottom: 16px; }
  .facts__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .fact { background: var(--ral-soft); border-radius: 16px; padding: 24px 14px; display: grid; justify-items: center; gap: 10px; text-align: center; font-weight: 600; font-size: 15px; }
  .fact__ico { color: var(--ral-accent); }
  @media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); gap: 32px; } }

  .faq { max-width: 820px; margin: 0 auto; display: grid; gap: 12px; }
  .faq details { border: 1px solid var(--line); border-radius: 16px; padding: 0 22px; background: var(--card); }
  .faq details[open] { border-color: var(--ral-line); background: var(--ral-soft); }
  .faq summary { cursor: pointer; list-style: none; padding: 18px 32px 18px 0; font-weight: 600; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 13px; font: 400 26px/1 var(--f-head); color: var(--ral-accent); }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { color: var(--muted); padding-bottom: 18px; }

  .cta {
    border-radius: 28px; padding: 56px; color: #fff; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 48px; align-items: center;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(160deg, color-mix(in srgb, var(--ral) 85%, #000), color-mix(in srgb, var(--ral) 30%, var(--graphite)) 60%, var(--graphite));
    box-shadow: 0 30px 60px rgba(17, 18, 22, 0.25);
  }
  .cta h2 { text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25); }
  .cta__text { display: grid; gap: 16px; }
  .cta__text p { color: rgba(255, 255, 255, 0.82); font-size: 18px; }
  .cta__ral { font-size: 15px !important; }
  @media (max-width: 900px) { .cta { grid-template-columns: minmax(0, 1fr); padding: 32px 20px; border-radius: 22px; } }

  .text { max-width: 820px; color: #3d3f47; }
  .text :global(h2) { font-size: 26px; color: var(--ink); margin: 32px 0 12px; }
  .text :global(h2:first-child) { margin-top: 0; }
  .text :global(ul) { padding-left: 20px; margin: 12px 0; }
  .text :global(li + li) { margin-top: 6px; }
</style>
