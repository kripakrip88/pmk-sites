---
// Знак «Палитры ДВ»: веер образцов, верхний — выбранный RAL.
import site from '../../src/lib/site.js';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <rect x="9" y="4" width="9" height="24" rx="3" fill="#d9d9d4" transform="rotate(-24 13.5 26)" />
    <rect x="11" y="4" width="9" height="24" rx="3" fill="#8d8f96" transform="rotate(-8 15.5 26)" />
    <rect x="13" y="4" width="9" height="24" rx="3" fill="var(--ral)" transform="rotate(10 17.5 26)" />
    <circle cx="17.5" cy="24" r="1.6" fill="#fff" />
  </svg>
  <span class="logo__word">{site.brand.name}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; }
  .logo rect { transition: fill 0.3s; }
  .logo__word { font: 700 19px/1 var(--f-head); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .logo--light .logo__word { color: #fff; }
</style>
