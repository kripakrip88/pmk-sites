---
// Форма «Палитры ДВ». Логика отправки общая — src/lib/lead-form.js (контракт разметки описан там).
---
<form class="lf" data-lead-form novalidate>
  <label class="lf__drop">
    <input name="files" type="file" multiple accept=".jpg,.jpeg,.png,.heic,.pdf,.dxf,.dwg,.zip,.rar,.7z" />
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" /></svg>
    <span><b data-lead-files>Фото или чертёж изделия</b><small>JPG, PDF, DXF — до 20 МБ</small></span>
  </label>
  <div class="lf__row">
    <label class="lf__f">
      <span>Телефон *</span>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7" required />
    </label>
    <label class="lf__f">
      <span>Имя</span>
      <input name="name" type="text" autocomplete="name" maxlength="200" />
    </label>
  </div>
  <label class="lf__f">
    <span>Что покрасить и в какой цвет</span>
    <textarea name="comment" rows="2" maxlength="5000" placeholder="Например: секции забора 2×1,5 м, 10 шт, RAL 7016"></textarea>
  </label>
  <label class="lf__hp" aria-hidden="true">Сайт <input name="website" tabindex="-1" autocomplete="off" /></label>
  <label class="lf__consent">
    <input name="consent" type="checkbox" value="true" required />
    <span>Согласен на <a href="/politika/" target="_blank">обработку персональных данных</a></span>
  </label>
  <button class="lf__btn" type="submit">Отправить заявку</button>
  <p class="lf__status" data-lead-status role="status" aria-live="polite"></p>
</form>

<style>
  .lf { background: #fff; color: var(--ink); border-radius: 20px; padding: 24px; display: grid; gap: 14px; }
  .lf__drop { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px; border: 1.5px dashed var(--ral-line); border-radius: 14px; background: var(--ral-soft); cursor: pointer; }
  .lf__drop:hover, .lf__drop:focus-within { border-color: var(--ral-accent); }
  .lf__drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .lf__drop svg { color: var(--ral-accent); flex: none; }
  .lf__drop span { display: grid; gap: 2px; }
  .lf__drop b { font-weight: 600; }
  .lf__drop small { font-size: 13px; color: var(--muted); }
  .lf__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .lf__f { display: grid; gap: 6px; }
  .lf__f span { font-size: 14px; font-weight: 500; color: var(--muted); }
  .lf__f input, .lf__f textarea { font: 400 16px/1.4 var(--f-text); color: var(--ink); background: #f4f4f2; width: 100%; border: 1px solid transparent; border-radius: 12px; padding: 12px 14px; resize: vertical; }
  .lf__f input:focus, .lf__f textarea:focus { outline: none; border-color: var(--ral-accent); background: #fff; }
  .lf__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf__consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--muted); }
  .lf__consent input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--ral-accent); flex: none; }
  .lf__consent a { color: var(--ink); text-underline-offset: 2px; }
  .lf__btn { font: 600 16px/1 var(--f-text); padding: 16px; border-radius: 12px; border: 0; cursor: pointer; background: var(--ral); color: var(--ral-ink); transition: background 0.3s, color 0.3s; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08); }
  .lf__btn:hover { background: color-mix(in srgb, var(--ral) 85%, #000); }
  .lf__btn:disabled { opacity: 0.6; cursor: wait; }
  .lf__status { font-size: 14px; font-weight: 600; }
  .lf__status:empty { display: none; }
  .lf__status[data-state='error'] { color: #b42318; }
  .lf__status[data-state='ok'] { color: #136c45; }
  .lf__status[data-state='busy'] { color: var(--muted); }
  @media (max-width: 520px) { .lf { padding: 18px; } .lf__row { grid-template-columns: minmax(0, 1fr); } }
</style>
