---
// Знак «Плазмореза»: дуга плазмы из сопла + искра.
interface Props { light?: boolean }
import site from '../../src/lib/site.js';
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="32" height="32">
      <rect width="32" height="32" rx="9" fill="var(--plasma)" />
      <path d="M11 7h10l-2 6h-6z" fill="#fff" />
      <path d="M16 14c-2.5 4-2.5 7 0 11 2.5-4 2.5-7 0-11z" fill="#c9c3ff" />
      <circle cx="22.5" cy="23.5" r="1.8" fill="var(--spark)" />
    </svg>
  </span>
  <span class="logo__word">{site.brand.name}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__word { font: 600 20px/1 var(--f-head); letter-spacing: -0.02em; color: var(--ink); }
  .logo--light .logo__word { color: #fff; }
</style>
