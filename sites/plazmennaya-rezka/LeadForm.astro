---
// Форма «Плазмореза». Логика отправки общая — src/lib/lead-form.js (контракт разметки описан там).
---
<form class="lf" data-lead-form novalidate>
  <label class="lf__drop">
    <input name="files" type="file" multiple accept=".dxf,.dwg,.pdf,.jpg,.jpeg,.png,.heic,.zip,.rar,.7z" />
    <span class="lf__ico" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4 M7 9l5-5 5 5 M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
    </span>
    <span><b data-lead-files>Загрузите чертёж</b><small>DXF, DWG, PDF или фото эскиза — до 20 МБ</small></span>
  </label>

  <div class="lf__row">
    <label class="lf__f">
      <span>Телефон *</span>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7" required />
    </label>
    <label class="lf__f">
      <span>Имя</span>
      <input name="name" type="text" autocomplete="name" maxlength="200" />
    </label>
  </div>
  <label class="lf__f">
    <span>Марка, толщина, количество</span>
    <textarea name="comment" rows="2" maxlength="5000" placeholder="Например: 09Г2С, 25 мм, фланцы 24 шт"></textarea>
  </label>
  <label class="lf__hp" aria-hidden="true">Сайт <input name="website" tabindex="-1" autocomplete="off" /></label>

  <label class="lf__consent">
    <input name="consent" type="checkbox" value="true" required />
    <span>Согласен на <a href="/politika/" target="_blank">обработку персональных данных</a></span>
  </label>
  <button class="btn btn--plasma lf__btn" type="submit">Получить расчёт</button>
  <p class="lf__status" data-lead-status role="status" aria-live="polite"></p>
</form>

<style>
  .lf { background: var(--card); color: var(--ink); border-radius: var(--r-lg); padding: 28px; display: grid; gap: 16px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25); }
  .lf__drop { position: relative; display: flex; align-items: center; gap: 14px; padding: 16px; border: 1.5px dashed #b9b3ff; border-radius: var(--r); background: var(--plasma-tint); cursor: pointer; transition: border-color 0.15s; }
  .lf__drop:hover, .lf__drop:focus-within { border-color: var(--plasma); }
  .lf__drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .lf__ico { width: 44px; height: 44px; border-radius: 12px; background: var(--plasma); color: #fff; display: grid; place-items: center; flex: none; }
  .lf__drop span:last-child { display: grid; gap: 2px; }
  .lf__drop b { font-weight: 600; }
  .lf__drop small { font-size: 13px; color: var(--muted); }
  .lf__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; }
  .lf__f { display: grid; gap: 6px; }
  .lf__f span { font-size: 14px; font-weight: 500; color: var(--muted); }
  .lf__f input, .lf__f textarea {
    font: 400 16px/1.4 var(--f-text); color: var(--ink); background: var(--bg); width: 100%;
    border: 1px solid transparent; border-radius: 12px; padding: 13px 14px; resize: vertical;
  }
  .lf__f input:focus, .lf__f textarea:focus { outline: none; border-color: var(--plasma); background: #fff; box-shadow: 0 0 0 4px var(--plasma-tint); }
  .lf__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf__consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--muted); }
  .lf__consent input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--plasma); flex: none; }
  .lf__consent a { color: var(--ink); text-underline-offset: 2px; }
  .lf__btn { width: 100%; }
  .lf__btn:disabled { opacity: 0.6; cursor: wait; }
  .lf__status { font-size: 14px; font-weight: 600; }
  .lf__status:empty { display: none; }
  .lf__status[data-state='error'] { color: #c0262d; }
  .lf__status[data-state='ok'] { color: #136c45; }
  .lf__status[data-state='busy'] { color: var(--muted); }
  @media (max-width: 560px) { .lf { padding: 20px; } .lf__row { grid-template-columns: minmax(0, 1fr); } }
</style>
