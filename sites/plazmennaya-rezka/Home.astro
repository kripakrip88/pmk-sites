---
// Посадочная «Плазмореза» — композиция по мотивам zeepay: герой + «пульт», бенто, шаги, сравнение, вопросы, полоса с формой.
import Panel from './Panel.astro';
import LeadForm from './LeadForm.astro';
import { Content as Text } from './text.md';
import site, { phoneHref } from '../../src/lib/site.js';

const b = site.bento;
const maxMark = Math.max(...b.ruler.marks);
const icons: Record<string, string> = {
  layout: 'M4 4h7v7H4z M13 4h7v4h-7z M13 10h7v10h-7z M4 13h7v7H4z',
  file: 'M14 3H6v18h12V7z M14 3v4h4 M9 13h6 M9 17h4',
  stack: 'M3 8l9-4 9 4-9 4z M3 12l9 4 9-4 M3 16l9 4 9-4',
};
---
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__text">
      <p class="hero__eyebrow"><span></span>Резка на ЧПУ {site.cityIn}</p>
      <h1>{site.hero.title}</h1>
      <p class="hero__lead">{site.hero.lead}</p>
      <div class="hero__btns">
        <a class="btn btn--plasma" href="#lead">Отправить чертёж <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#compare">Плазма или лазер?</a>
      </div>
      <ul class="hero__chips">
        {site.hero.chips.map((c) => <li><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>{c}</li>)}
      </ul>
    </div>
    <div class="hero__panel"><Panel /></div>
  </div>
</section>

<section class="sec" id="thickness">
  <div class="wrap">
    <div class="sec__head"><h2>{b.title}</h2></div>
    <div class="bento">
      <article class="bc bc--big">
        <div class="bc__top">
          <h3>{b.ruler.head} до {site.maxThickness} мм</h3>
          <p>{b.ruler.text}</p>
          <ul class="bc__mat">{b.ruler.materials.map(([m, t]) => <li>{m} <b>до {t} мм</b></li>)}</ul>
        </div>
        <div class="rl" aria-hidden="true" style={`grid-template-columns:repeat(${b.ruler.marks.length},minmax(0,1fr))`}>
          {b.ruler.marks.map((m) => (
            <div class:list={['rl__col', { 'rl__col--on': m >= b.ruler.from }]}>
              <div class="rl__bar" style={`height:${Math.max(6, (m / maxMark) * 100)}%`}></div>
              <span>{m}</span>
            </div>
          ))}
        </div>
        <div class="rl__legend"><span class="rl__dot rl__dot--on"></span>от {b.ruler.from} мм плазма дешевле лазера <span class="rl__dot"></span>тонкий лист</div>
      </article>
      {b.cards.map(([ico, h, p]) => (
        <article class="bc">
          <span class="bc__ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d={icons[ico]} /></svg></span>
          <h3>{h}</h3>
          <p>{p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sec sec--white" id="steps">
  <div class="wrap">
    <div class="sec__head"><h2>Как это работает</h2></div>
    <ol class="steps">
      {site.steps.map(([h, p], i) => (
        <li class="st">
          <span class="st__n">{i + 1}</span>
          <h3>{h}</h3>
          <p>{p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="sec" id="compare">
  <div class="wrap">
    <div class="sec__head"><h2>{site.compare.title}</h2><p>{site.compare.lead}</p></div>
    <div class="cmp" role="table" aria-label={site.compare.title}>
      <div class="cmp__row cmp__head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="cmp__p">Плазма</span>
        <span role="columnheader">Лазер</span>
      </div>
      {site.compare.rows.map(([k, p, l]) => (
        <div class="cmp__row" role="row">
          <span role="rowheader" class="cmp__k">{k}</span>
          <span role="cell" class="cmp__p">{p}</span>
          <span role="cell">{l}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec sec--white" id="faq">
  <div class="wrap faq">
    <div class="faq__intro">
      <h2>Частые вопросы</h2>
      <p>Не нашли ответа — позвоните, технолог подскажет по вашей детали.</p>
      <a class="btn btn--ghost" href={phoneHref}>Позвонить</a>
    </div>
    <div class="faq__list">
      {site.faq.map(([q, a], i) => (
        <details open={i === 0}>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="cta" id="lead">
  <div class="wrap cta__in">
    <div class="cta__text">
      <h2>Пришлите чертёж — посчитаем раскрой и цену</h2>
      <p>Подойдёт файл или фото эскиза с размерами. Перезвоним, уточним марку и толщину, ответим ценой и сроком.</p>
    </div>
    <LeadForm />
  </div>
</section>

<section class="sec" id="about">
  <div class="wrap text"><Text /></div>
</section>

<style>
  .hero { padding: 48px 0 88px; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; align-items: center; }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--plasma); background: var(--plasma-tint); padding: 6px 12px; border-radius: 999px; margin-bottom: 20px; }
  .hero__eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--spark); }
  .hero h1 { font-size: clamp(36px, 5.2vw, 64px); }
  .hero__lead { color: var(--muted); font-size: 19px; margin-top: 20px; max-width: 560px; }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__chips { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 15px; font-weight: 500; }
  .hero__chips li { display: inline-flex; align-items: center; gap: 6px; }
  .hero__chips svg { color: var(--plasma); }
  .hero__panel { display: flex; justify-content: center; position: relative; }
  .hero__panel::before { content: ''; position: absolute; inset: 8% 4% -6% 10%; background: radial-gradient(closest-side, rgba(75, 60, 255, 0.18), transparent); z-index: -1; }
  @media (max-width: 900px) { .hero__in { grid-template-columns: minmax(0, 1fr); gap: 40px; } .hero { padding-top: 24px; } }

  .sec--white { background: var(--card); }

  .bento { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px; }
  .bc { background: var(--card); border-radius: var(--r-lg); padding: 24px 28px; box-shadow: 0 1px 2px rgba(14, 19, 48, 0.04); border: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
  .bc p { color: var(--muted); }
  .bc__ico { width: 44px; height: 44px; border-radius: 12px; background: var(--plasma-tint); color: var(--plasma); display: grid; place-items: center; margin-bottom: 2px; }
  .bc--big { grid-row: span 3; background: linear-gradient(160deg, #ffffff 0%, var(--plasma-tint) 100%); gap: 24px; grid-template-rows: auto minmax(200px, 1fr) auto; align-content: stretch; }
  .bc--big h3 { font-size: clamp(24px, 2.6vw, 32px); }
  .bc__top { display: grid; gap: 10px; max-width: 520px; }
  .bc__mat { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .bc__mat li { font-size: 14px; color: var(--muted); background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
  .bc__mat b { color: var(--plasma); font-weight: 600; }
  .rl { display: grid; gap: 10px; align-items: end; height: 100%; min-height: 200px; }
  .rl__col { display: grid; grid-template-rows: 1fr auto; gap: 8px; height: 100%; text-align: center; font: 600 14px/1 var(--f-head); color: var(--muted); }
  .rl__bar { align-self: end; border-radius: 8px 8px 4px 4px; background: #d9dbea; }
  .rl__col--on { color: var(--plasma); }
  .rl__col--on .rl__bar { background: linear-gradient(180deg, #7b6fff, var(--plasma)); }
  .rl__legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 14px; color: var(--muted); }
  .rl__dot { width: 10px; height: 10px; border-radius: 3px; background: #d9dbea; margin-left: 8px; }
  .rl__dot--on { background: var(--plasma); margin-left: 0; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .bc--big { grid-row: auto; grid-template-rows: auto auto auto; }
    .rl { min-height: 160px; height: 160px; gap: 6px; }
  }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; counter-reset: st; }
  .st { background: var(--bg); border-radius: var(--r-lg); padding: 28px; display: grid; gap: 10px; align-content: start; }
  .st__n { width: 44px; height: 44px; border-radius: 50%; background: var(--plasma); color: #fff; display: grid; place-items: center; font: 600 18px/1 var(--f-head); margin-bottom: 8px; }
  .st p { color: var(--muted); }
  @media (max-width: 860px) { .steps { grid-template-columns: minmax(0, 1fr); } }

  .cmp { background: var(--card); border-radius: var(--r-lg); border: 1px solid var(--line); overflow: hidden; }
  .cmp__row { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr); }
  .cmp__row > span { padding: 18px 24px; border-top: 1px solid var(--line); }
  .cmp__head > span { border-top: 0; font: 600 18px/1.2 var(--f-head); }
  .cmp__k { font-weight: 600; }
  .cmp__p { background: var(--plasma-tint); color: var(--ink); }
  .cmp__head .cmp__p { background: var(--plasma); color: #fff; }
  .cmp__row > span:last-child { color: var(--muted); }
  .cmp__head > span:last-child { color: var(--ink); }
  @media (max-width: 640px) {
    .cmp__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .cmp__k { grid-column: 1 / -1; background: var(--bg); padding: 12px 16px !important; }
    .cmp__head > span:first-child { display: none; }
    .cmp__row > span { padding: 14px 16px; font-size: 15px; }
  }

  .faq { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px; align-items: start; }
  .faq__intro { display: grid; gap: 16px; justify-items: start; position: sticky; top: 100px; }
  .faq__intro p { color: var(--muted); }
  .faq__list { display: grid; gap: 12px; }
  .faq details { background: var(--bg); border-radius: var(--r); padding: 0 22px; }
  .faq summary { cursor: pointer; list-style: none; padding: 18px 32px 18px 0; font-weight: 600; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: ''; position: absolute; right: 2px; top: 24px; width: 10px; height: 10px; border-right: 2px solid var(--plasma); border-bottom: 2px solid var(--plasma); transform: rotate(45deg); transition: transform 0.2s; }
  .faq details[open] summary::after { transform: rotate(-135deg); top: 28px; }
  .faq details p { color: var(--muted); padding-bottom: 18px; }
  @media (max-width: 860px) { .faq { grid-template-columns: minmax(0, 1fr); gap: 28px; } .faq__intro { position: static; } }

  .cta { background: var(--night); color: #fff; padding: 88px 0; position: relative; overflow: hidden; }
  .cta::before { content: ''; position: absolute; width: 640px; height: 640px; right: -160px; top: -240px; border-radius: 50%; background: radial-gradient(closest-side, rgba(75, 60, 255, 0.55), transparent); }
  .cta__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 48px; align-items: center; }
  .cta h2 { font-size: clamp(28px, 3.4vw, 44px); }
  .cta__text p { color: rgba(255, 255, 255, 0.75); margin-top: 16px; font-size: 18px; max-width: 480px; }
  @media (max-width: 900px) { .cta__in { grid-template-columns: minmax(0, 1fr); } .cta { padding: 64px 0; } }

  .text { max-width: 820px; color: #3b4160; }
  .text :global(h2) { font-size: 24px; color: var(--ink); margin: 32px 0 12px; }
  .text :global(h2:first-child) { margin-top: 0; }
  .text :global(ul) { padding-left: 20px; margin: 12px 0; }
  .text :global(li + li) { margin-top: 6px; }
</style>
