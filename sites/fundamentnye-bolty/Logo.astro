---
// Знак «Опоры»: гайка, сквозь которую проходит шпилька, + слово.
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<span class:list={['logo', { 'logo--small': small }]}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <path d="M16 3.5 27 9.75v12.5L16 28.5 5 22.25V9.75z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
    <circle cx="16" cy="16" r="5" fill="currentColor" />
  </svg>
  <span class="logo__word">Опора</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; color: var(--zinc); }
  .logo__word { font: 700 19px/1 var(--f-text); letter-spacing: -0.01em; color: var(--text); }
  .logo--small svg { width: 20px; height: 20px; }
  .logo--small .logo__word { font-size: 15px; }
</style>
