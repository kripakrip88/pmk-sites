---
// «Аватар» паспорта: торец болта — шпилька в гайке на шайбе, вид сверху.
---
<div class="be" aria-hidden="true">
  <svg viewBox="0 0 120 120" width="120" height="120">
    <circle cx="60" cy="60" r="44" fill="none" stroke="var(--rule-strong)" stroke-width="2" />
    <path d="M60 26 89.4 43v34L60 94 30.6 77V43z" fill="var(--sheet)" stroke="var(--text)" stroke-width="2.5" stroke-linejoin="round" />
    <circle cx="60" cy="60" r="20" fill="var(--zinc)" />
    <circle cx="60" cy="60" r="20" fill="none" stroke="var(--zinc-dark)" stroke-width="1.5" stroke-dasharray="2.2 2.2" />
    <circle cx="60" cy="60" r="13" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.2" />
  </svg>
</div>

<style>
  .be { width: 132px; height: 132px; border-radius: 50%; background: linear-gradient(145deg, #f4f5f6, #dfe2e5); display: grid; place-items: center; flex: none; box-shadow: inset 0 0 0 1px var(--rule); }
  @media (max-width: 720px) { .be { width: 104px; height: 104px; } .be svg { width: 94px; height: 94px; } }
</style>
