---
// Свой первый экран «Шва»: внизу во всю ширину — стык двух пластин и сварной шов с чешуёй.
// Цвет чешуи идёт как цвета побежалости: холодная сталь → солома → бронза → фиолетовый → синий → расплав → дуга.
// Искры — CSS-анимация, при «уменьшить движение» выключены (base.css).
import Icon from '../_rabota/Icon.astro';
import site, { phoneHref } from '../../src/lib/site.js';

const h = site.hero;
const TIP = 1010, Y = 172;
const stops: [number, string][] = [
  [0, '#4f545b'], [0.4, '#6f737a'], [0.6, '#b49b62'], [0.72, '#9a6234'],
  [0.81, '#6b4a8f'], [0.885, '#3d5ca8'], [0.94, '#ff8a2a'], [1, '#fff1c8'],
];
const hex = (s: string) => [1, 3, 5].map((i) => parseInt(s.slice(i, i + 2), 16));
function color(t: number) {
  for (let i = 1; i < stops.length; i++) {
    const [t1, c1] = stops[i];
    if (t <= t1) {
      const [t0, c0] = stops[i - 1];
      const k = (t - t0) / (t1 - t0);
      const a = hex(c0), b = hex(c1);
      return `rgb(${a.map((v, j) => Math.round(v + (b[j] - v) * k)).join(',')})`;
    }
  }
  return stops[stops.length - 1][1];
}
// чешуя: дуги выпуклостью по ходу сварки (вправо), каждая следующая перекрывает предыдущую
const scales = Array.from({ length: Math.floor(TIP / 8) }, (_, i) => {
  const x = i * 8 + 4;
  return { x, c: color(x / TIP) };
});
const sparks = Array.from({ length: 18 }, (_, i) => {
  const a = (-160 + (i * 140) / 17) * (Math.PI / 180); // веер вверх-в стороны
  const d = 70 + ((i * 37) % 90);
  return { dx: Math.round(Math.cos(a) * d), dy: Math.round(Math.sin(a) * d), delay: ((i * 0.17) % 1.2).toFixed(2), r: (1.2 + (i % 3) * 0.5).toFixed(1) };
});
---
<section class="wh">
  <div class="wrap wh__in">
    <span class="wh__badge"><span></span>{h.badge}</span>
    <h1>{h.title}</h1>
    <p class="wh__lead">{h.lead}</p>
    <ul class="wh__facts">{h.facts.map((f) => <li><Icon name="check" size={18} />{f}</li>)}</ul>
    <div class="wh__btns">
      <a class="btn btn--primary" href="#apply">Откликнуться</a>
      <a class="btn btn--outline" href={phoneHref}>Позвонить</a>
    </div>
  </div>

  <svg class="wh__seam" viewBox="0 -220 1440 520" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <defs>
      <linearGradient id="pl-a" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1c1f23" /><stop offset="1" stop-color="#2d3238" /></linearGradient>
      <linearGradient id="pl-b" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#30353b" /><stop offset="1" stop-color="#1a1d21" /></linearGradient>
      <radialGradient id="glow"><stop offset="0" stop-color="#fff6dc" stop-opacity="1" /><stop offset=".12" stop-color="#ffd27a" stop-opacity=".9" /><stop offset=".4" stop-color="#ff7a1a" stop-opacity=".35" /><stop offset="1" stop-color="#ff7a1a" stop-opacity="0" /></radialGradient>
      <radialGradient id="haz" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ff7a1a" stop-opacity=".35" /><stop offset="1" stop-color="#ff7a1a" stop-opacity="0" /></radialGradient>
      <linearGradient id="torch" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3f46" /><stop offset=".5" stop-color="#22262b" /><stop offset="1" stop-color="#121417" /></linearGradient>
      <linearGradient id="bead" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={TIP} y2="0">
        {stops.map(([o, c]) => <stop offset={o} stop-color={c} />)}
      </linearGradient>
      <linearGradient id="bead-v" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".28" /><stop offset=".45" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".45" /></linearGradient>
      <filter id="blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
    </defs>
    <rect x="0" y="40" width="1440" height="132" fill="url(#pl-a)" />
    <rect x="0" y="172" width="1440" height="128" fill="url(#pl-b)" />
    <path d="M0 40H1440" stroke="#4a5058" stroke-width="2" />
    {Array.from({ length: 10 }, (_, i) => <path d={`M0 ${60 + i * 11}H1440`} stroke="#fff" stroke-opacity=".025" />)}
    {Array.from({ length: 10 }, (_, i) => <path d={`M0 ${186 + i * 11}H1440`} stroke="#fff" stroke-opacity=".02" />)}
    <path d={`M${TIP} 172H1440`} stroke="#0b0c0e" stroke-width="3" />
    <ellipse cx={TIP - 40} cy={Y} rx="220" ry="90" fill="url(#haz)" />
    <g>
      <rect x="-20" y={Y - 23} width={TIP + 26} height="46" rx="23" fill="url(#bead)" />
      {scales.map((s) => (
        <path d={`M${s.x - 7} ${Y - 21}q19 21 0 42`} fill="none" stroke="#000" stroke-opacity=".28" stroke-width="2.2" />
      ))}
      {scales.map((s) => (
        <path d={`M${s.x - 4} ${Y - 17}q13 17 0 34`} fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="1.6" />
      ))}
      <rect x="-20" y={Y - 23} width={TIP + 26} height="46" rx="23" fill="url(#bead-v)" />
    </g>
    <circle cx={TIP + 6} cy={Y} r="260" fill="url(#glow)" />
    <circle cx={TIP + 6} cy={Y} r="20" fill="#fffaf0" filter="url(#blur)" />
    <g transform={`rotate(-52 ${TIP} ${Y})`}>
      <path d={`M${TIP + 16} ${Y - 6}L${TIP + 64} ${Y - 15}V${Y + 15}L${TIP + 16} ${Y + 6}z`} fill="#5b4a3a" />
      <rect x={TIP + 64} y={Y - 17} width="760" height="34" rx="6" fill="url(#torch)" />
      <path d={`M${TIP + 70} ${Y - 10}H${TIP + 820}`} stroke="#fff" stroke-opacity=".12" stroke-width="2" />
      <path d={`M${TIP + 200} ${Y - 17}v34 M${TIP + 214} ${Y - 17}v34`} stroke="#0b0c0e" stroke-width="3" />
    </g>
    <g class="wh__sparks">
      {sparks.map((p) => <circle cx={TIP + 6} cy={Y} r={p.r} style={`--dx:${p.dx}px;--dy:${p.dy}px;animation-delay:${p.delay}s`} />)}
    </g>
  </svg>
</section>

<style>
  .wh { position: relative; overflow: hidden; min-height: 760px; padding: 72px 0 300px;
    background: radial-gradient(900px 420px at 72% 100%, rgba(255, 122, 26, 0.16), transparent 70%), var(--bg); }
  .wh__in { position: relative; z-index: 2; display: grid; gap: 22px; justify-items: start; }
  .wh__badge { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; padding: 7px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
  .wh__badge span { width: 8px; height: 8px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 10px var(--primary); }
  .wh h1 { font-size: clamp(42px, 6.4vw, 84px); max-width: 900px; line-height: 1.08; }
  .wh__lead { font-size: 20px; color: var(--muted); max-width: 620px; }
  .wh__facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-weight: 700; font-size: 15px; }
  .wh__facts li { display: inline-flex; align-items: center; gap: 6px; }
  .wh__facts :global(svg) { color: var(--primary); }
  .wh__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .wh__btns .btn--primary { box-shadow: 0 0 0 0 rgba(255, 122, 26, 0.5), 0 10px 30px rgba(255, 122, 26, 0.25); }
  .wh__seam { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 520px; z-index: 1; pointer-events: none; 
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 38%); mask-image: linear-gradient(to bottom, transparent 0, #000 38%); }
  .wh__sparks circle { fill: #ffd27a; animation: spark 1.2s ease-out infinite; }
  @keyframes spark {
    0% { transform: translate(0, 0); opacity: 1; }
    80% { opacity: 0.9; }
    100% { transform: translate(var(--dx), calc(var(--dy) + 40px)); opacity: 0; }
  }
  @media (max-width: 760px) {
    .wh { min-height: 0; padding: 40px 0 210px; }
    .wh__seam { height: 347px; }
    .wh__lead { font-size: 18px; }
  }
</style>
