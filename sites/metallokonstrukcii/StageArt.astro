---
// Иллюстрация этапа — фрагмент инженерного листа: основная/тонкая/осевая линии, размеры со стрелками,
// штриховка разрезов, выноски моноширинным шрифтом. Оранжевым — только рез и сварные швы.
interface Props { kind: string; label: string }
const { kind, label } = Astro.props;
const k = kind; // суффикс id — на странице пять рисунков
const A = `url(#ar-${k})`;
const H = `url(#ht-${k})`;
---
<figure class="art" aria-hidden="true">
  <svg viewBox="0 0 480 220" width="480" height="220">
    <defs>
      <marker id={`ar-${k}`} viewBox="0 0 8 6" refX="8" refY="3" markerWidth="8" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L8 3L0 6z" fill="#3f3f46" /></marker>
      <pattern id={`ht-${k}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V5" stroke="#71717a" stroke-width=".8" /></pattern>
      <pattern id={`wd-${k}`} width="8" height="8" patternUnits="userSpaceOnUse"><path d="M0 8L8 0M0 0L8 8" stroke="#a1a1aa" stroke-width=".6" /></pattern>
    </defs>

    {kind === 'drawing' && (
      <g class="ln">
        <rect x="8" y="8" width="464" height="204" class="th" />
        <g class="tb">
          <rect x="318" y="160" width="154" height="52" />
          <path d="M318 176H472 M318 194H472 M378 194V212 M428 194V212" />
          <text x="324" y="172">КМД</text><text x="324" y="189">Колонна К-1</text>
          <text x="324" y="207">Сталь</text><text x="384" y="207">М 1:20</text><text x="434" y="207">Лист 3</text>
        </g>
        <path d="M83 18V196" class="ax" />
        <rect x="70" y="30" width="26" height="120" class="mn" />
        <path d="M74 30V150 M92 30V150" class="tn" />
        <path d="M70 150l-10 0 10-16z M96 150l10 0-10-16z" class="mn" />
        <rect x="52" y="150" width="62" height="8" class="mn" />
        <path d="M60 158V184 M106 158V184" class="hd" />
        <path d="M58 96h8 M100 96h8" class="mn2" /><text x="54" y="92">А</text><text x="106" y="92">А</text>
        <path d="M30 30H66 M30 158H50" class="tn" />
        <path d="M36 30V158" class="tn" marker-start={A} marker-end={A} />
        <text x="32" y="100" transform="rotate(-90 32 100)" text-anchor="middle">3200</text>
        <path d="M52 162V196 M114 162V196" class="tn" />
        <path d="M52 192H114" class="tn" marker-start={A} marker-end={A} /><text x="83" y="188" text-anchor="middle">400</text>
        <path d="M106 142L136 176H186" class="tn" marker-start={A} />
        <path d="M140 176l5-7 5 7z" class="wl" /><text x="154" y="173">6</text>
        <text x="190" y="44" class="hd2">А–А</text>
        <path d="M168 60h64v9h-29v42h29v9h-64v-9h29V69h-29z" fill={H} class="mn" />
        <path d="M200 52V128 M160 90H240" class="ax" />
        <path d="M168 124V146 M232 124V146" class="tn" /><path d="M168 142H232" class="tn" marker-start={A} marker-end={A} /><text x="200" y="138" text-anchor="middle">300</text>
        <path d="M236 60H258 M236 120H258" class="tn" /><path d="M252 60V120" class="tn" marker-start={A} marker-end={A} />
        <text x="262" y="94">300</text>
        <text x="300" y="34" class="hd2">Примечания</text>
        <path d="M300 48H452 M300 62H430 M300 76H446 M300 90H410" class="nt" />
      </g>
    )}

    {kind === 'cutting' && (
      <g class="ln">
        <rect x="20" y="40" width="290" height="140" class="mn" />
        <path d="M20 26V36 M310 26V36" class="tn" /><path d="M20 30H310" class="tn" marker-start={A} marker-end={A} /><text x="165" y="26" text-anchor="middle">3000</text>
        <path d="M8 40H16 M8 180H16" class="tn" /><path d="M12 40V180" class="tn" marker-start={A} marker-end={A} />
        <rect x="30" y="50" width="70" height="70" class="tn2" />
        {[[38, 58], [92, 58], [38, 112], [92, 112]].map(([x, y]) => <circle cx={x} cy={y} r="4" class="tn2" />)}
        <circle cx="65" cy="85" r="10" class="tn2" />
        <path d="M110 50h56L110 106z M172 50v56h-56z" class="tn2" />
        <path d="M30 130h120v18H30z M30 154h120v18H30z" class="tn2" />
        <circle cx="222" cy="96" r="42" class="tn2" /><circle cx="222" cy="96" r="17" class="tn2" />
        {[0, 60, 120, 180, 240, 300].map((a) => <circle cx={222 + 30 * Math.cos((a * Math.PI) / 180)} cy={96 + 30 * Math.sin((a * Math.PI) / 180)} r="3.4" class="tn2" />)}
        <path d="M160 156h104v18H160z" class="tn2" />
        <rect x="276" y="40" width="34" height="140" fill={H} class="tn" /><text x="293" y="196" text-anchor="middle">остаток</text>
        <path d="M222 50a46 46 0 1 1-0.1 0" class="cut" />
        <circle cx="222" cy="46" r="2.6" fill="#ea580c" /><path d="M214 46h8" class="cutl" />
        <text x="330" y="54" class="hd2">Профиль</text>
        <path d="M330 68H468 M330 84H468 M330 70H468 M330 82H468" class="mn" />
        <path d="M376 60V92 M422 60V92" class="cut" />
        <path d="M330 98V112 M376 98V112 M422 98V112" class="tn" />
        <path d="M330 106H376" class="tn" marker-start={A} marker-end={A} /><text x="353" y="102" text-anchor="middle">1250</text>
        <path d="M376 106H422" class="tn" marker-start={A} marker-end={A} /><text x="399" y="102" text-anchor="middle">1250</text>
        <path d="M330 150H350" class="cut" /><text x="356" y="153">траектория реза</text>
        <circle cx="340" cy="168" r="2.6" fill="#ea580c" /><text x="356" y="171">точка врезки</text>
        <rect x="332" y="180" width="16" height="10" fill={H} class="tn" /><text x="356" y="189">деловой остаток</text>
      </g>
    )}

    {kind === 'welding' && (
      <g class="ln">
        <path d="M70 14V206" class="ax" />
        <rect x="56" y="20" width="28" height="186" class="mn" /><path d="M60 20V206 M80 20V206" class="tn" />
        <rect x="84" y="62" width="8" height="76" class="mn" />
        <path d="M92 74H276 M92 126H276" class="mn" /><path d="M92 79H276 M92 121H276" class="tn" /><path d="M276 74V126" class="mn" />
        <path d="M92 100H284" class="ax" />
        {[70, 84, 116, 130].map((y) => <circle cx="88" cy={y} r="3" class="tn" />)}
        <path d="M92 74l7-7v7z M92 126l7 7v-7z" class="wf" />
        <path d="M99 133L150 170H226" class="tn" marker-start={A} />
        <path d="M156 170l6-9 6 9z" class="wl" /><text x="172" y="166">6</text>
        <path d="M218 164l6 6-6 6" class="tn" /><text x="232" y="174">Т1</text>
        <text x="320" y="34" class="hd2">Б–Б</text>
        <path d="M330 52h80v10h-36v56h36v10h-80v-10h36V62h-36z" fill={H} class="mn" />
        <path d="M364 62l-5 5h5z M376 62l5 5h-5z M364 118l-5-5h5z M376 118l5-5h-5z" class="wf" />
        <path d="M370 42V140 M318 90H422" class="ax" />
        <path d="M330 134V156 M410 134V156" class="tn" /><path d="M330 152H410" class="tn" marker-start={A} marker-end={A} /><text x="370" y="148" text-anchor="middle">200</text>
        <path d="M414 52H436 M414 128H436" class="tn" /><path d="M430 52V128" class="tn" marker-start={A} marker-end={A} /><text x="440" y="94">300</text>
        <text x="318" y="186">швы угловые, катет 6 мм</text>
        <text x="318" y="200">сварка полуавтоматом</text>
      </g>
    )}

    {kind === 'painting' && (
      <g class="ln">
        <path d="M30 128c40-3 80 3 120 0s80 3 120 0v54H30z" fill={H} class="mn" />
        <path d="M30 118c40-3 80 3 120 0s80 3 120 0v10c-40 3-80-3-120 0s-80-3-120 0z" fill="#e4e4e7" class="tn" />
        <path d="M30 106c40-3 80 3 120 0s80 3 120 0v12c-40 3-80-3-120 0s-80-3-120 0z" fill="#3f3f46" class="tn" />
        <path d="M30 100V190 M270 100V190" class="tn" />
        <path d="M60 160L40 204H96" class="tn" marker-start={A} /><text x="44" y="200">металл</text>
        <path d="M120 122L140 68H200" class="tn" marker-start={A} /><text x="146" y="64">грунт</text>
        <path d="M200 110L214 40H270" class="tn" marker-start={A} /><text x="220" y="36">покрытие RAL</text>
        <path d="M276 106H290 M276 128H290" class="tn" /><path d="M286 92V106" class="tn" marker-end={A} /><path d="M286 142V128" class="tn" marker-end={A} /><text x="292" y="121">δ</text>
        <path d="M318 46H470" class="mn" />
        {[338, 378, 418, 458].map((x) => <path d={`M${x} 46v10 M${x - 4} 56h8v4h-8z`} class="tn" />)}
        <rect x="324" y="70" width="64" height="80" class="mn" /><text x="356" y="166" text-anchor="middle">камера</text>
        <rect x="404" y="70" width="64" height="80" class="mn" /><text x="436" y="166" text-anchor="middle">печь</text>
        <path d="M352 78l-10 20 M360 78l0 22 M368 78l10 20" class="dsh" />
        <path d="M412 136q8-8 16 0t16 0t16 0" class="tn" /><text x="436" y="182" text-anchor="middle">180–200 °C</text>
        <path d="M388 110H404" class="tn" marker-end={A} />
      </g>
    )}

    {kind === 'truck' && (
      <g class="ln">
        <path d="M24 60H220 M24 86H220 M24 64H220 M24 82H220 M24 60V86 M220 60V86" class="mn" />
        <path d="M14 73H230" class="ax" />
        <rect x="104" y="66" width="36" height="14" fill="#fff" class="tn" /><text x="122" y="77" text-anchor="middle" class="mk">К-1</text>
        <path d="M24 94V108 M220 94V108" class="tn" /><path d="M24 104H220" class="tn" marker-start={A} marker-end={A} /><text x="122" y="100" text-anchor="middle">6000</text>
        <text x="24" y="138" class="hd2">Пакет, сечение</text>
        {[0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => (
          <path d={`M${30 + c * 44} ${150 + r * 20}h32v3h-14v10h14v3h-32v-3h14v-10h-14z`} class="mn" />
        )))}
        {[0, 1, 2, 3].map((r) => <rect x="24" y={146 + r * 20} width="182" height="4" fill="url(#wd-truck)" class="tn" />)}
        <rect x="20" y="142" width="190" height="72" rx="8" class="strap" />
        <text x="252" y="36" class="hd2">Ведомость отправочных марок</text>
        <rect x="252" y="46" width="216" height="120" class="mn" />
        <path d="M252 66H468 M252 86H468 M252 106H468 M252 126H468 M252 146H468 M316 46V166 M380 46V166" class="tn" />
        <text x="260" y="60">Марка</text><text x="324" y="60">Кол.</text><text x="388" y="60">Масса, кг</text>
        {[['К-1', '4'], ['К-2', '2'], ['Б-1', '6'], ['Б-2', '6'], ['Ф-1', '2']].map(([m, n], i) => (
          <>
            <text x="260" y={80 + i * 20} class="mk">{m}</text><text x="324" y={80 + i * 20}>{n}</text>
            <path d={`M388 ${76 + i * 20}h${[56, 42, 64, 38, 28][i]}`} class="nt" />
          </>
        ))}
      </g>
    )}
  </svg>
  <figcaption class="mono">{label}</figcaption>
</figure>

<style>
  .art { margin: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fcfcfc; }
  .art svg { width: 100%; height: auto; }
  .art figcaption { font-size: 12px; color: var(--muted); background: #fff; border-top: 1px solid var(--line); padding: 7px 12px; }
  .art :global(.ln) { fill: none; stroke: #18181b; stroke-linejoin: miter; }
  .art :global(.ln text) { fill: #3f3f46; stroke: none; font: 400 9.5px var(--f-mono); }
  .art :global(.ln .hd2) { font-weight: 500; fill: #18181b; font-size: 10.5px; }
  .art :global(.ln .mk) { font-weight: 500; fill: #18181b; }
  .art :global(.th) { stroke-width: 1.4; }
  .art :global(.mn) { stroke-width: 1.5; }
  .art :global(.mn2) { stroke-width: 2.2; }
  .art :global(.tn) { stroke-width: 0.7; stroke: #3f3f46; }
  .art :global(.tn2) { stroke-width: 1.1; }
  .art :global(.ax) { stroke-width: 0.6; stroke: #71717a; stroke-dasharray: 14 3 2 3; }
  .art :global(.hd) { stroke-width: 0.8; stroke: #3f3f46; stroke-dasharray: 4 3; }
  .art :global(.dsh) { stroke-width: 0.7; stroke: #71717a; stroke-dasharray: 2 3; }
  .art :global(.nt) { stroke: #d4d4d8; stroke-width: 4; }
  .art :global(.tb) { stroke-width: 1; }
  .art :global(.cut) { stroke: #ea580c; stroke-width: 1.6; stroke-dasharray: 6 3; }
  .art :global(.cutl) { stroke: #ea580c; stroke-width: 1.2; }
  .art :global(.wl) { fill: #18181b; stroke: none; }
  .art :global(.wf) { fill: #ea580c; stroke: none; }
  .art :global(.strap) { stroke: #ea580c; stroke-width: 1.2; stroke-dasharray: 8 3; }
</style>
