---
// Знак «Металлоконструкций ДВ»: двутавр в чёрном круге.
import site from '../../src/lib/site.js';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <circle cx="16" cy="16" r="16" fill={light ? '#fff' : '#0a0a0a'} />
    <path d="M9.5 9h13v3h-5v8h5v3h-13v-3h5v-8h-5z" fill={light ? '#0a0a0a' : '#fff'} />
  </svg>
  <span class="logo__word">{site.brand.name}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__word { font: 600 17px/1 var(--f-text); letter-spacing: -0.02em; color: var(--fg); white-space: nowrap; }
  .logo--light .logo__word { color: #fff; }
  @media (max-width: 420px) { .logo__word { font-size: 15px; } }
</style>
