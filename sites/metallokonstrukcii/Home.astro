---
// Посадочная «Металлоконструкций ДВ» — по мотивам Track: шапка с быстрой формой звонка,
// лента этапов заказа (вместо журнала версий), вопросы, тёмная полоса с полной формой.
import StageArt from './StageArt.astro';
import LeadForm from './LeadForm.astro';
import { Content as Text } from './text.md';
import site from '../../src/lib/site.js';

const h = site.hero;
const groups = [
  ['do', 'Что делаем'],
  ['you', 'Что нужно от вас'],
  ['result', 'Результат'],
] as const;
---
<section class="hero">
  <div class="wrap hero__in">
    <span class="badge">{h.eyebrow}</span>
    <h1>{h.title}</h1>
    <p class="hero__lead">{h.lead}</p>

    <form class="qf" data-lead-form novalidate>
      <div class="qf__row">
        <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Ваш телефон" aria-label="Телефон" required />
        <button class="btn btn--dark" type="submit">Перезвоните мне</button>
      </div>
      <input type="hidden" name="comment" value="Быстрая заявка: перезвонить" />
      <label class="qf__hp" aria-hidden="true">Сайт <input name="website" tabindex="-1" autocomplete="off" /></label>
      <label class="qf__consent"><input name="consent" type="checkbox" value="true" required /> Согласен на <a href="/politika/" target="_blank">обработку персональных данных</a></label>
      <p class="qf__status" data-lead-status role="status" aria-live="polite"></p>
    </form>

    <ul class="hero__tags" aria-label="Что изготавливаем">
      {h.products.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<section class="tl" id="stages" aria-label="Этапы заказа">
  <div class="wrap">
    {site.stages.map((s, i) => (
      <article class="tl__item">
        <div class="tl__side">
          <span class="tl__ver mono">Этап {s.n}</span>
          <span class="tl__label">{s.label}</span>
        </div>
        <div class="tl__rail" aria-hidden="true"><span></span></div>
        <div class="tl__body">
          <h2>{s.title}</h2>
          <p class="tl__text">{s.text}</p>
          <ul class="tl__points">{s.points.map((p) => <li>{p}</li>)}</ul>
          <StageArt kind={s.art} label={`этап ${s.n} · ${s.label.toLowerCase()}`} />
          <div class="tl__groups">
            {groups.map(([k, t], gi) => (
              <details open={gi === 0 && i === 0}>
                <summary><span class={`tag tag--${k}`}>{t}</span></summary>
                <ul>{(s as any)[k].map((p: string) => <li>{p}</li>)}</ul>
              </details>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="faq" id="faq">
  <div class="wrap faq__in">
    <div class="faq__head">
      <h2>Есть вопросы?</h2>
      <p>Если ответа нет — позвоните или оставьте заявку, обсудим вашу конструкцию.</p>
    </div>
    <div class="faq__list">
      {site.faq.map(([q, a], i) => (
        <details open={i === 0}>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="cta" id="lead">
  <div class="wrap cta__in">
    <div class="cta__text">
      <h2>Пришлите проект или эскиз</h2>
      <p>Посчитаем металл, работу и доставку, назовём цену и срок. Если чертежей нет — опишите, что нужно, и приложите фото места.</p>
    </div>
    <LeadForm />
  </div>
</section>

<section class="about">
  <div class="wrap text"><Text /></div>
</section>

<style>
  .hero { padding: 72px 0 56px; border-bottom: 1px solid var(--line); }
  .hero__in { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .hero h1 { font-size: clamp(34px, 5vw, 56px); max-width: 820px; }
  .hero__lead { color: var(--muted); font-size: 18px; max-width: 620px; }
  .qf { display: grid; gap: 8px; justify-items: center; margin-top: 6px; width: 100%; max-width: 440px; }
  .qf__row { display: flex; gap: 8px; width: 100%; }
  .qf__row input { flex: 1; min-width: 0; font: 400 15px/1 var(--f-text); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line-strong); }
  .qf__row input:focus { outline: none; border-color: var(--fg); box-shadow: 0 0 0 3px #e4e4e7; }
  .qf__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .qf__consent { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .qf__consent input { width: 16px; height: 16px; margin: 0; accent-color: var(--fg); }
  .qf__consent a { color: var(--fg); text-underline-offset: 2px; }
  .qf__status { font-size: 14px; font-weight: 500; }
  .qf__status:empty { display: none; }
  .qf__status[data-state='error'] { color: #b91c1c; }
  .qf__status[data-state='ok'] { color: #166534; }
  .hero__tags { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 720px; }
  .hero__tags li { font-size: 14px; padding: 6px 12px; border-radius: 999px; background: var(--soft); color: #3f3f46; }
  @media (max-width: 480px) { .qf__row { flex-direction: column; } .hero { padding: 48px 0 40px; } }

  .tl { padding: 64px 0 24px; }
  .tl__item { display: grid; grid-template-columns: 150px 32px minmax(0, 1fr); gap: 0 20px; }
  .tl__side { display: grid; justify-items: end; align-content: start; gap: 8px; padding-top: 2px; text-align: right; }
  .tl__ver { background: var(--fg); color: #fff; font-size: 13px; padding: 5px 9px; border-radius: 6px; }
  .tl__label { color: var(--muted); font-size: 14px; }
  .tl__rail { position: relative; display: flex; justify-content: center; }
  .tl__rail::before { content: ''; position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line-strong); }
  .tl__item:first-child .tl__rail::before { top: 12px; }
  .tl__item:last-child .tl__rail::before { bottom: auto; height: 12px; }
  .tl__rail span { position: relative; width: 13px; height: 13px; margin-top: 6px; border-radius: 50%; background: var(--fg); box-shadow: 0 0 0 4px #fff, 0 0 0 5px var(--line-strong); }
  .tl__body { padding-bottom: 72px; display: grid; gap: 14px; }
  .tl__body h2 { font-size: clamp(22px, 2.4vw, 26px); }
  .tl__text { color: #52525b; }
  .tl__points { margin: 0; padding-left: 20px; color: #3f3f46; display: grid; gap: 4px; }
  .tl__groups details { border-bottom: 1px solid var(--line); }
  .tl__groups summary { list-style: none; cursor: pointer; padding: 12px 28px 12px 0; position: relative; }
  .tl__groups summary::-webkit-details-marker { display: none; }
  .tl__groups summary::after { content: ''; position: absolute; right: 6px; top: 18px; width: 8px; height: 8px; border-right: 1.6px solid #52525b; border-bottom: 1.6px solid #52525b; transform: rotate(45deg); transition: transform 0.15s; }
  .tl__groups details[open] summary::after { transform: rotate(-135deg); top: 22px; }
  .tl__groups ul { margin: 0 0 14px; padding-left: 20px; color: #3f3f46; display: grid; gap: 4px; }
  .tag { display: inline-block; font-size: 13px; font-weight: 500; padding: 3px 8px; border-radius: 6px; }
  .tag--do { background: var(--do-bg); color: var(--do-fg); }
  .tag--you { background: var(--you-bg); color: var(--you-fg); }
  .tag--result { background: var(--res-bg); color: var(--res-fg); }
  @media (max-width: 760px) {
    .tl__item { grid-template-columns: 24px minmax(0, 1fr); gap: 0 14px; }
    .tl__side { grid-column: 2; grid-row: 1; justify-items: start; text-align: left; display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
    .tl__rail { grid-column: 1; grid-row: 1 / span 2; }
    .tl__body { grid-column: 2; grid-row: 2; padding-bottom: 48px; }
    .tl__item:last-child .tl__rail::before { height: 12px; }
  }

  .faq { padding: 72px 0; background: var(--soft); border-top: 1px solid var(--line); }
  .faq__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px; }
  .faq__head { display: grid; gap: 12px; align-content: start; }
  .faq__head h2 { font-size: clamp(28px, 3.4vw, 40px); }
  .faq__head p { color: var(--muted); }
  .faq__list details { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 0 18px; }
  .faq__list details + details { margin-top: 10px; }
  .faq__list summary { list-style: none; cursor: pointer; padding: 16px 28px 16px 0; font-weight: 500; position: relative; }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::after { content: '+'; position: absolute; right: 0; top: 12px; font: 400 22px/1 var(--f-mono); color: var(--muted); }
  .faq__list details[open] summary::after { content: '−'; }
  .faq__list details p { color: #52525b; padding-bottom: 16px; }
  @media (max-width: 820px) { .faq__in { grid-template-columns: minmax(0, 1fr); gap: 24px; } }

  .cta { background: var(--night); color: #fff; padding: 72px 0; }
  .cta__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 48px; align-items: center; }
  .cta h2 { font-size: clamp(28px, 3.4vw, 40px); }
  .cta__text p { color: #a1a1aa; margin-top: 14px; font-size: 17px; max-width: 460px; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: minmax(0, 1fr); } }

  .about { padding: 72px 0; }
  .text { max-width: 760px; color: #3f3f46; }
  .text :global(h2) { font-size: 24px; color: var(--fg); margin: 32px 0 12px; }
  .text :global(h2:first-child) { margin-top: 0; }
  .text :global(ul) { padding-left: 20px; margin: 12px 0; }
  .text :global(li + li) { margin-top: 6px; }
</style>
