---
// Общая посадочная вакансии. Различия сайтов задаёт site.json → theme:
//   hero: 'left' | 'right' | 'center' — где текст и иллюстрация; cards: 'plain' | 'boxed' | 'list' — вид «Условий»;
//   order: порядок средних разделов (offer, jobs, duties, steps, faq); illo — иллюстрация профессии.
import Illo from './Illo.astro';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { Content as Text } from '@site/text.md';
import site, { phoneHref } from '../../src/lib/site.js';

const t = site.theme;
const h = site.hero;
const order: string[] = t.order;
// Свой первый экран сайта (sites/<slug>/Hero.astro), если есть. Glob через @site — только папка текущего
// сайта: шаблон '../*/' тянул стили первых экранов всех сайтов в каждую сборку.
const heroMods = import.meta.glob('@site/Hero.astro', { eager: true });
const CustomHero = (Object.values(heroMods)[0] as any)?.default ?? null;
---
{CustomHero && <CustomHero />}
{!CustomHero && <section class:list={['hero', `hero--${t.hero}`]}>
  <div class="wrap hero__in">
    <div class="hero__text">
      <span class="hero__badge"><span></span>{h.badge}</span>
      <h1>{h.title}</h1>
      <p class="hero__lead">{h.lead}</p>
      <ul class="hero__facts">
        {h.facts.map((f) => <li><Icon name="check" size={18} />{f}</li>)}
      </ul>
      <div class="hero__btns">
        <a class="btn btn--primary" href="#apply">Откликнуться</a>
        <a class="btn btn--outline" href={phoneHref}>Позвонить</a>
      </div>
    </div>
    <div class="hero__art"><Illo kind={t.illo} /></div>
  </div>
</section>}

{order.map((s) => (
  <>
    {s === 'offer' && (
      <section class="sec sec--alt" id="offer">
        <div class="wrap">
          <div class="sec__head"><h2>{site.offer.title}</h2><p>{site.offer.lead}</p></div>
          <div class:list={['offer', `offer--${t.cards}`]}>
            {site.offer.items.map(([ico, title, text]) => (
              <div class="of">
                <span class="of__ico"><Icon name={ico} size={22} /></span>
                <div><h3>{title}</h3><p>{text}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
    {s === 'jobs' && site.jobs && (
      <section class="sec" id="jobs">
        <div class="wrap">
          <div class="sec__head"><h2>{site.jobs.title}</h2><p>{site.jobs.lead}</p></div>
          <div class="jobs">
            {site.jobs.items.map(([title, text]) => (
              <a class="job" href="#apply"><h3>{title}</h3><p>{text}</p><span class="job__go">Откликнуться →</span></a>
            ))}
          </div>
        </div>
      </section>
    )}
    {s === 'duties' && (
      <section class="sec" id="duties">
        <div class="wrap">
          <div class="sec__head"><h2>{site.duties.title}</h2></div>
          <div class="dt">
            <div class="dt__col"><h3>Чем предстоит заниматься</h3><ul>{site.duties.do.map((d) => <li>{d}</li>)}</ul></div>
            <div class="dt__col"><h3>Кого ищем</h3><ul>{site.duties.need.map((d) => <li>{d}</li>)}</ul></div>
          </div>
        </div>
      </section>
    )}
    {s === 'steps' && (
      <section class="sec sec--alt" id="steps">
        <div class="wrap">
          <div class="sec__head"><h2>Как устроиться</h2></div>
          <ol class="steps">
            {site.steps.map(([title, text], i) => (
              <li class="st"><span class="st__n">{i + 1}</span><h3>{title}</h3><p>{text}</p></li>
            ))}
          </ol>
        </div>
      </section>
    )}
    {s === 'faq' && (
      <section class="sec" id="faq">
        <div class="wrap faq">
          <h2>Вопросы</h2>
          <div class="faq__list">
            {site.faq.map(([q, a]) => (
              <details><summary>{q}</summary><p>{a}</p></details>
            ))}
          </div>
        </div>
      </section>
    )}
  </>
))}

<section class="sec" id="apply">
  <div class="wrap">
    <div class="band">
      <div class="band__text">
        <h2>{site.apply.title}</h2>
        <p>{site.apply.text}</p>
        <a class="band__phone" href={phoneHref}><Icon name="phone" size={20} />{site.contacts.phone}</a>
      </div>
      <LeadForm />
    </div>
  </div>
</section>

<section class="sec sec--alt" id="about">
  <div class="wrap text"><Text /></div>
</section>

<style>
  .hero { padding: 64px 0 80px; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 40px; align-items: center; }
  .hero--right .hero__text { order: 2; }
  .hero--center .hero__in { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
  .hero--center .hero__facts, .hero--center .hero__btns { justify-content: center; }
  .hero--center .hero__art { max-width: 420px; }
  .hero__text { display: grid; gap: 20px; justify-items: start; }
  .hero--center .hero__text { justify-items: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; padding: 7px 12px; border-radius: 999px; background: var(--soft); }
  .hero__badge span { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .hero h1 { font-size: clamp(36px, 5.4vw, 64px); }
  .hero__lead { font-size: 19px; color: var(--muted); max-width: 560px; }
  .hero__facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; font-size: 15px; }
  .hero__facts li { display: inline-flex; align-items: center; gap: 6px; }
  .hero__facts :global(svg) { color: var(--primary-text); }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__art { display: flex; justify-content: center; }
  @media (max-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .hero--right .hero__text { order: 0; }
    .hero__art { order: -1; max-width: 340px; margin: 0 auto; }
    .hero { padding: 32px 0 56px; }
  }

  .sec--alt { background: var(--soft); }

  .offer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 40px; }
  .of { display: flex; gap: 14px; align-items: flex-start; }
  .of__ico { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--primary); color: var(--primary-ink); }
  .of h3 { margin-bottom: 6px; }
  .of p { color: var(--muted); font-size: 16px; }
  .offer--boxed .of { background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; flex-direction: column; }
  .offer--boxed .of__ico { border-radius: var(--r-btn); }
  .offer--list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; }
  .offer--list .of { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .offer--list .of__ico { background: transparent; color: var(--primary-text); border: 2px solid var(--primary-text); }
  @media (max-width: 900px) { .offer, .offer--list { grid-template-columns: minmax(0, 1fr); gap: 20px; } .offer--list { gap: 0; } }

  .jobs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .job { display: grid; gap: 8px; align-content: start; text-decoration: none; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; transition: border-color 0.15s, transform 0.15s; }
  .job:hover { border-color: var(--primary-text); transform: translateY(-2px); }
  .job p { color: var(--muted); font-size: 15px; }
  .job__go { color: var(--primary-text); font-weight: 600; font-size: 15px; margin-top: 4px; }
  @media (max-width: 900px) { .jobs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .jobs { grid-template-columns: minmax(0, 1fr); } }

  .dt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
  .dt__col { border: 1px solid var(--line); border-radius: var(--r); padding: 28px; background: var(--card); }
  .dt__col h3 { margin-bottom: 14px; }
  .dt__col ul { margin: 0; padding-left: 20px; display: grid; gap: 8px; color: var(--muted); }
  .dt__col li::marker { color: var(--primary-text); }
  @media (max-width: 760px) { .dt { grid-template-columns: minmax(0, 1fr); } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .st { display: grid; gap: 10px; align-content: start; }
  .st__n { width: 48px; height: 48px; border-radius: var(--r-btn); display: grid; place-items: center; background: var(--step-bg, var(--fg)); color: var(--step-fg, var(--bg)); font: var(--head-weight) 20px/1 var(--f-head); }
  .st p { color: var(--muted); }
  @media (max-width: 760px) { .steps { grid-template-columns: minmax(0, 1fr); } }

  .faq { display: grid; grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr); gap: 40px; }
  .faq__list { display: grid; gap: 10px; }
  .faq details { border: 1px solid var(--line); border-radius: var(--r); padding: 0 20px; background: var(--card); }
  .faq summary { list-style: none; cursor: pointer; padding: 16px 28px 16px 0; font-weight: 600; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 11px; font: 400 24px/1 var(--f-text); color: var(--primary-text); }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { color: var(--muted); padding-bottom: 16px; }
  @media (max-width: 760px) { .faq { grid-template-columns: minmax(0, 1fr); gap: 20px; } }

  .band { background: var(--band); color: var(--band-ink); border-radius: calc(var(--r) + 8px); padding: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 40px; align-items: center; }
  .band__text { display: grid; gap: 16px; justify-items: start; }
  .band__text p { opacity: 0.8; font-size: 18px; }
  .band__phone { display: inline-flex; align-items: center; gap: 10px; font: var(--head-weight) 24px/1.2 var(--f-head); text-decoration: none; }
  @media (max-width: 860px) { .band { grid-template-columns: minmax(0, 1fr); padding: 28px 18px; } }

  .text { max-width: 820px; color: var(--muted); }
  .text :global(h2) { font-size: 26px; color: var(--fg); margin: 28px 0 10px; text-transform: none; }
  .text :global(h2:first-child) { margin-top: 0; }
  .text :global(ul) { padding-left: 20px; margin: 10px 0; }
  .text :global(li + li) { margin-top: 6px; }
</style>
