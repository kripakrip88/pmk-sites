---
// Форма отклика. Логика отправки общая — src/lib/lead-form.js (телефон обязателен, согласие, ловушка для ботов).
import site from '../../src/lib/site.js';
---
<form class="af" data-lead-form novalidate>
  <div class="af__row">
    <label class="af__f"><span>Телефон *</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7" required /></label>
    <label class="af__f"><span>Имя</span><input name="name" type="text" autocomplete="name" maxlength="200" /></label>
  </div>
  <label class="af__f"><span>{site.form.question}</span><textarea name="comment" rows="3" maxlength="5000" placeholder={site.form.placeholder}></textarea></label>
  <label class="af__file">
    <input name="files" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.heic" />
    <span data-lead-files>Прикрепить резюме или фото документов</span><small>необязательно · до 20 МБ</small>
  </label>
  <label class="af__hp" aria-hidden="true">Сайт <input name="website" tabindex="-1" autocomplete="off" /></label>
  <label class="af__consent"><input name="consent" type="checkbox" value="true" required /> <span>Согласен на <a href="/politika/" target="_blank">обработку персональных данных</a></span></label>
  <button class="btn btn--primary af__btn" type="submit">Отправить отклик</button>
  <p class="af__status" data-lead-status role="status" aria-live="polite"></p>
</form>

<style>
  .af { background: var(--card); color: var(--fg); border-radius: calc(var(--r) + 4px); padding: 26px; display: grid; gap: 14px; }
  .af__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .af__f { display: grid; gap: 6px; }
  .af__f span { font-size: 14px; font-weight: 600; color: var(--muted); }
  .af__f input, .af__f textarea { font: 400 16px/1.4 var(--f-text); color: var(--fg); background: var(--soft); width: 100%; border: 2px solid transparent; border-radius: var(--r-btn); padding: 12px 14px; resize: vertical; }
  .af__f input:focus, .af__f textarea:focus { outline: none; border-color: var(--primary-text); background: var(--card); }
  .af__file { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; padding: 12px 14px; border: 2px dashed var(--line); border-radius: var(--r-btn); cursor: pointer; font-weight: 600; font-size: 15px; }
  .af__file:hover, .af__file:focus-within { border-color: var(--primary-text); }
  .af__file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .af__file small { color: var(--muted); font-weight: 400; font-size: 13px; }
  .af__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .af__consent { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--muted); }
  .af__consent input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--primary); flex: none; }
  .af__consent a { color: var(--fg); text-underline-offset: 2px; }
  .af__btn { width: 100%; }
  .af__btn:disabled { opacity: 0.6; cursor: wait; }
  .af__status { font-size: 14px; font-weight: 600; }
  .af__status:empty { display: none; }
  .af__status[data-state='error'] { color: #c62828; }
  .af__status[data-state='ok'] { color: #1b7f3b; }
  .af__status[data-state='busy'] { color: var(--muted); }
  @media (max-width: 520px) { .af { padding: 18px; } .af__row { grid-template-columns: minmax(0, 1fr); } }
</style>
