---
// Знак «Кромка»: деталь со срезанным углом, на срезе — точка лазера.
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
    <path d="M3 3h16l10 10v16H3z" fill="none" stroke="currentColor" stroke-width="2.2" />
    <path d="M19 3l10 10" stroke="var(--laser)" stroke-width="2.2" />
    <circle cx="24" cy="8" r="3.2" fill="var(--laser)" />
    <circle cx="12" cy="18" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
  </svg>
  <span class="logo__word">Кромка</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo--light { color: var(--on-ink); }
  .logo__word { font: 700 20px/1 var(--f-head); letter-spacing: 0.02em; text-transform: uppercase; }
</style>
