---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Materials from '../components/Materials.astro';
import Steps from '../components/Steps.astro';
import Advantages from '../components/Advantages.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import site from '../lib/site.js';
import { Content as Text } from '@site/text.md';

const c = site.contacts;
const url = Astro.site!.href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: site.service,
    serviceType: site.service,
    areaServed: { '@type': 'City', name: site.city },
    url,
    provider: {
      '@type': 'LocalBusiness',
      name: `${site.brand.name} — ${site.brand.tagline}`,
      telephone: c.phone,
      email: c.email,
      address: { '@type': 'PostalAddress', addressLocality: site.city, streetAddress: c.address.replace(/^г\.\s*[^,]+,\s*/, ''), addressCountry: 'RU' },
      openingHours: 'Mo-Fr 09:00-18:00',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: site.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={site.seo.title} description={site.seo.description} schema={schema}>
  <Hero />
  <Materials />
  <Steps />
  <Advantages />
  <Cta />
  <section class="section">
    <div class="container article"><Text /></div>
  </section>
  <Faq />
</Base>

<style>
  .article { max-width: 820px; }
  .article :global(h2) { margin: 40px 0 16px; }
  .article :global(h2:first-child) { margin-top: 0; }
  .article :global(p), .article :global(li) { color: #3a424a; font-size: 17px; }
  .article :global(p + p) { margin-top: 14px; }
  .article :global(ul) { padding-left: 20px; margin: 16px 0; display: grid; gap: 8px; }
</style>
