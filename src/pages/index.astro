---
// Главная = посадочная. Вёрстка и дизайн — sites/<SITE>/Home.astro, здесь только SEO-разметка.
import Layout from '@site/Layout.astro';
import Home from '@site/Home.astro';
import site from '../lib/site.js';

const c = site.contacts;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: site.service,
    serviceType: site.service,
    areaServed: { '@type': 'City', name: site.city },
    url: Astro.site!.href,
    provider: {
      '@type': 'LocalBusiness',
      name: site.brand.name,
      telephone: c.phone,
      ...(c.email && { email: c.email }),
      address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'RU' },
      openingHours: c.openingHours,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: site.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Layout title={site.seo.title} description={site.seo.description} schema={schema}>
  <Home />
</Layout>
