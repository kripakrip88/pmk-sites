---
// Заявка → PocketBase (коллекция leads). На сервере nginx проксирует /api/ в PocketBase,
// поэтому каждый домен шлёт на свой же адрес. Для локальной разработки — PUBLIC_PB_URL.
import site, { mailHref } from '../lib/site.js';
const pbUrl = import.meta.env.PUBLIC_PB_URL ?? '';
---
<form class="lead" id="lead" data-pb={pbUrl} data-site={site.slug} novalidate>
  <h2 class="lead__title">Рассчитать стоимость</h2>
  <p class="lead__sub">Приложите чертёж — ответим с ценой и сроком в течение 24 часов.</p>

  <label class="f">
    <span>Телефон<i aria-hidden="true">*</i></span>
    <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 ___ ___-__-__" required />
  </label>
  <label class="f">
    <span>Имя</span>
    <input name="name" type="text" autocomplete="name" maxlength="200" />
  </label>
  <label class="f">
    <span>Что нужно изготовить</span>
    <textarea name="comment" rows="3" maxlength="5000" placeholder="Металл, толщина, количество"></textarea>
  </label>
  <label class="f f--file">
    <input name="files" type="file" multiple accept=".dxf,.dwg,.pdf,.jpg,.jpeg,.png,.heic,.zip,.rar,.7z,.step,.stp" />
    <span class="f__drop">📎 <b>Прикрепить чертёж</b> <small>DXF, DWG, PDF, фото — до 20 МБ</small></span>
  </label>
  <!-- ловушка для ботов: человек это поле не видит -->
  <label class="visually-hidden" aria-hidden="true">Сайт<input name="website" tabindex="-1" autocomplete="off" /></label>

  <label class="consent">
    <input name="consent" type="checkbox" value="true" required />
    <span>Согласен на <a href="/politika/" target="_blank">обработку персональных данных</a></span>
  </label>

  <button class="btn btn--accent lead__btn" type="submit">Отправить заявку</button>
  <p class="lead__status" role="status" aria-live="polite"></p>
  <p class="lead__alt">или напишите на <a href={mailHref}>{site.contacts.email}</a></p>
</form>

<script>
  import { goal } from '../lib/goal.js';

  const MAX = 20 * 1024 * 1024;
  for (const form of document.querySelectorAll<HTMLFormElement>('form.lead')) {
    const status = form.querySelector<HTMLElement>('.lead__status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const fileInput = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const drop = form.querySelector<HTMLElement>('.f__drop b')!;

    fileInput.addEventListener('change', () => {
      const n = fileInput.files?.length ?? 0;
      drop.textContent = n ? `Файлов: ${n}` : 'Прикрепить чертёж';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const say = (text: string, ok = false) => { status.textContent = text; status.dataset.ok = String(ok); };
      const fd = new FormData(form);
      const phone = String(fd.get('phone') || '');
      if (phone.replace(/\D/g, '').length < 10) return say('Укажите телефон — нам нужно куда перезвонить.');
      if (!fd.get('consent')) return say('Отметьте согласие на обработку данных.');
      const files = [...(fileInput.files ?? [])];
      if (files.some((f) => f.size > MAX)) return say('Файл больше 20 МБ — пришлите его на почту.');

      fd.set('site', form.dataset.site!);
      fd.set('page', location.href.slice(0, 500));
      const utm = Object.fromEntries([...new URLSearchParams(location.search)].filter(([k]) => /^(utm_|yclid)/.test(k)));
      fd.set('utm', JSON.stringify(utm));
      fd.delete('files');
      for (const f of files) fd.append('files', f);

      btn.disabled = true;
      say('Отправляем…');
      try {
        const res = await fetch(`${form.dataset.pb}/api/collections/leads/records`, { method: 'POST', body: fd });
        if (!res.ok) throw new Error(String(res.status));
        goal('lead_sent');
        form.reset();
        drop.textContent = 'Прикрепить чертёж';
        say('Заявка отправлена. Перезвоним в рабочее время.', true);
      } catch {
        say('Не получилось отправить. Позвоните нам или напишите на почту.');
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .lead { background: var(--surface); color: var(--ink); border-radius: var(--r-card); padding: 28px; box-shadow: var(--shadow); display: grid; gap: 14px; }
  .lead__title { font-size: 24px; font-weight: 800; }
  .lead__sub { color: var(--muted); font-size: 15px; margin-top: -6px; }
  .f { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
  .f i { color: var(--danger); font-style: normal; margin-left: 2px; }
  .f input, .f textarea {
    font: 500 16px/1.4 var(--font); color: var(--ink); background: var(--bg);
    border: 1.5px solid var(--line); border-radius: var(--r-btn); padding: 13px 14px; width: 100%; resize: vertical;
  }
  .f input:focus, .f textarea:focus { outline: none; border-color: var(--ink); background: #fff; }
  .f--file { position: relative; }
  .f--file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .f__drop { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; border: 1.5px dashed #c5cbd2; border-radius: var(--r-btn); padding: 13px 14px; }
  .f__drop small { color: var(--muted); font-weight: 500; }
  .f--file:hover .f__drop, .f--file:focus-within .f__drop { border-color: var(--ink); }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--muted); }
  .consent input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--ink); flex: none; }
  .lead__btn { width: 100%; padding: 18px; font-size: 16px; }
  .lead__btn:disabled { opacity: 0.6; cursor: wait; }
  .lead__status { font-size: 14px; font-weight: 600; color: var(--danger); min-height: 1px; }
  .lead__status[data-ok='true'] { color: #3d7a00; }
  .lead__status:empty { display: none; }
  .lead__alt { font-size: 13px; color: var(--muted); text-align: center; }
</style>
