---
import site, { phoneHref, mailHref } from '../lib/site.js';
const c = site.contacts;
---
<footer class="ftr" id="contacts">
  <div class="container ftr__in">
    <div>
      <div class="eyebrow">Контакты</div>
      <a class="ftr__phone" href={phoneHref}>{c.phone}</a>
      <p class="ftr__muted">{c.hours}</p>
    </div>
    <div>
      <p><a href={mailHref}>{c.email}</a></p>
      <p class="ftr__muted">{c.address}</p>
      <p class="ftr__msg">
        {c.whatsapp && <a href={c.whatsapp} target="_blank" rel="noopener">WhatsApp</a>}
        {c.telegram && <a href={c.telegram} target="_blank" rel="noopener">Telegram</a>}
      </p>
    </div>
    <div class="ftr__legal">
      <p>{site.service} {site.cityIn}</p>
      <p><a href="/politika/">Политика обработки персональных данных</a></p>
      <p class="ftr__muted">Информация на сайте не является публичной офертой.</p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--ink); color: #fff; padding: 56px 0; }
  .ftr__in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .ftr p + p { margin-top: 8px; }
  .ftr a { text-decoration: none; }
  .ftr a:hover { color: var(--accent); }
  .ftr__phone { display: block; font-size: 26px; font-weight: 800; margin-bottom: 6px; }
  .ftr__muted { color: var(--muted-on-dark); font-size: 14px; }
  .ftr__msg { display: flex; gap: 16px; font-weight: 700; }
  .ftr__legal { font-size: 14px; }
  .ftr__legal a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .ftr__in { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
