---
import site from '../lib/site.js';
---
<section class="section section--dark" id="steps">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow">Как заказать</div><h2>От чертежа до отгрузки</h2></div>
      <p>Можно начать без чертежа: пришлите фото эскиза с размерами.</p>
    </div>
    <ol class="steps">
      {site.steps.map(([t, s], i) => (
        <li><span class="steps__n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{s}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .steps li { background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: var(--r-card); padding: 24px; display: grid; gap: 10px; align-content: start; }
  .steps__n { font-size: 14px; font-weight: 800; color: var(--accent); }
  .steps p { color: var(--muted-on-dark); font-size: 15px; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
